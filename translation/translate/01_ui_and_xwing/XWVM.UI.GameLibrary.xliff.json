    {
      "id": "XWVM.UI.GameLibrary.xliff::XWVM.UI.GameLibrary::Dialog.ControlsInvalidNotification.Text::segment-1",
      "file_index": 0,
      "file_id": "XWVM.UI.GameLibrary",
      "unit_id": "Dialog.ControlsInvalidNotification.Text",
      "segment_index": 0,
      "source": "XWVM has detected invalid control bindings for:\n<b>{controls}</b>\nThe default keyboard and mouse bindings will now be applied and saved unless you cancel. Controller bindings will not be affected.\n\n<b>Continuing without applying default binding settings may affect critical game interactivity, and is not recommended.</b>",
      "target_zh_TW": "XWVM 偵測到下列控制項的按鍵綁定無效：\n<b>{controls}</b>\n除非你取消，否則將套用並儲存預設的鍵盤與滑鼠綁定。控制器綁定不受影響。\n\n<b>若不套用預設綁定設定就繼續，可能會影響關鍵的遊戲操作，不建議這麼做。</b>",
      "source_format": "text",
      "context": "XWVM.UI.GameLibrary / Dialog.ControlsInvalidNotification.Text",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
