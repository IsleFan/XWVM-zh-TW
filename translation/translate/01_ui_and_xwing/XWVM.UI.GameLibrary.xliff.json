    {
      "id": "XWVM.UI.GameLibrary.xliff::XWVM.UI.GameLibrary::FolderSetup.HeaderText::segment-1",
      "file_index": 0,
      "file_id": "XWVM.UI.GameLibrary",
      "unit_id": "FolderSetup.HeaderText",
      "segment_index": 0,
      "source": "XWVM requires that you have a compatible game installed on your computer, and that you select the folder where it is installed.\nWhen you select a folder with a valid installation of compatible game, it will be indicated at the right hand list.",
      "target_zh_TW": "XWVM 需要你的電腦上已安裝相容的遊戲，並選取其安裝資料夾。\n選取含有有效相容遊戲安裝的資料夾後，右側清單會顯示該遊戲。",
      "source_format": "text",
      "context": "XWVM.UI.GameLibrary / FolderSetup.HeaderText",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.UI.GameLibrary.xliff::XWVM.UI.GameLibrary::FolderSetup.CDROMText::segment-1",
      "file_index": 0,
      "file_id": "XWVM.UI.GameLibrary",
      "unit_id": "FolderSetup.CDROMText",
      "segment_index": 0,
      "source": "If you have a retail version of a compatible game on CD-ROM, either insert the disk, or copy its content to a folder on your PC.",
      "target_zh_TW": "如果你有相容遊戲的 CD-ROM 零售版，請放入光碟，或將光碟內容複製到電腦上的資料夾。",
      "source_format": "text",
      "context": "XWVM.UI.GameLibrary / FolderSetup.CDROMText",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
