  "entries": [
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::pressToContinue::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "pressToContinue",
      "segment_index": 0,
      "source": "Press Fire to continue.",
      "target_zh_TW": "按下開火鍵繼續。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / pressToContinue",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_sfoils::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_sfoils",
      "segment_index": 0,
      "source": "If your craft has s-foils, you won't be able to fire when they are closed.",
      "target_zh_TW": "如果你的戰機有 S翼，在 S翼收合時將無法開火。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_sfoils",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_capitalShipDistance::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_capitalShipDistance",
      "segment_index": 0,
      "source": "Keep your distance from enemy capital ships - their turrets can pack a punch.",
      "target_zh_TW": "與敵方主力艦保持距離——它們的砲塔威力驚人。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_capitalShipDistance",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_powerLevels::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_powerLevels",
      "segment_index": 0,
      "source": "Maintain your power levels to maximise damage done by your lasers.",
      "target_zh_TW": "維持你的能量分配，讓雷射砲發揮最大傷害。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_powerLevels",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_rotateShields::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_rotateShields",
      "segment_index": 0,
      "source": "Rotate your shields to face the enemy for maximum protection.",
      "target_zh_TW": "將護盾轉向敵人方向，以獲得最佳防護。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_rotateShields",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_prioritiseObjectives::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_prioritiseObjectives",
      "segment_index": 0,
      "source": "Prioritise your mission objectives carefully - sometimes, blowing stuff up <b>isn't</b> the answer.",
      "target_zh_TW": "謹慎安排任務目標的優先順序——有時候，把東西炸掉<b>並不是</b>正確答案。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_prioritiseObjectives",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_wingmenOrders::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_wingmenOrders",
      "segment_index": 0,
      "source": "Issue orders to your wingmen to maximise their effectiveness.",
      "target_zh_TW": "對僚機下達命令，讓他們發揮最大效用。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_wingmenOrders",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_linkWeapons::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_linkWeapons",
      "segment_index": 0,
      "source": "Try linking your weapons together to increase your firepower.",
      "target_zh_TW": "試著將武器連動發射，以提升火力。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_linkWeapons",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_tieSpeeds::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_tieSpeeds",
      "segment_index": 0,
      "source": "Most TIEs are fast, but unshielded - use this to your advantage.",
      "target_zh_TW": "大多數鈦戰機速度很快，但沒有護盾——好好利用這一點。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_tieSpeeds",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_inflightMap::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_inflightMap",
      "segment_index": 0,
      "source": "The inflight map can provide vital information about your mission objectives.",
      "target_zh_TW": "飛行中地圖能提供關於任務目標的重要資訊。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_inflightMap",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_pilotProvingGround::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_pilotProvingGround",
      "segment_index": 0,
      "source": "The <b>Pilot Proving Ground</b> provides an opportunity to hone flying skills for new and experienced pilots alike.",
      "target_zh_TW": "<b>飛行員試煉場</b>讓新手與資深飛行員都有機會磨練飛行技巧。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_pilotProvingGround",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_repairPriority::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_repairPriority",
      "segment_index": 0,
      "source": "Only one system on your craft can be repaired at any one time, so prioritise your systems carefully.",
      "target_zh_TW": "戰機上一次只能修復一個系統，請謹慎安排系統的修復順序。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_repairPriority",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_wreckageCollision::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_wreckageCollision",
      "segment_index": 0,
      "source": "Be careful not to collide with the wreckage of any destroyed ships - you can still take damage.",
      "target_zh_TW": "小心別撞上被摧毀艦船的殘骸——你仍然會受到損傷。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_wreckageCollision",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_historicalMissions::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_historicalMissions",
      "segment_index": 0,
      "source": "Hone your combat skills by flying <b>Historical Missions</b>.",
      "target_zh_TW": "駕駛<b>歷史任務</b>來磨練你的戰鬥技巧。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_historicalMissions",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_scopes::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_scopes",
      "segment_index": 0,
      "source": "Use your scopes to maintain awareness of other craft on the battlefield.",
      "target_zh_TW": "善用掃描器，隨時掌握戰場上其他艦艇的動向。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_scopes",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_wotanWeave::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_wotanWeave",
      "segment_index": 0,
      "source": "The <b>Wotan Weave</b> is favoured by many pilots to escape from a tricky situation.",
      "target_zh_TW": "許多飛行員偏好用<b>沃坦迂迴</b>擺脫棘手的處境。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_wotanWeave",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_ejection::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_ejection",
      "segment_index": 0,
      "source": "Ejecting near some types of enemy ship is likely to result in your capture.",
      "target_zh_TW": "在某些類型的敵艦附近彈射逃生，很可能會讓你遭俘。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_ejection",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_hyperspace::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_hyperspace",
      "segment_index": 0,
      "source": "Plotting a hyperspace course takes a few seconds - don't leave yourself vulnerable during the jump.",
      "target_zh_TW": "規劃超空間航線需要幾秒鐘——跳躍期間別讓自己暴露在危險中。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_hyperspace",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_moveLeft::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_moveLeft",
      "segment_index": 0,
      "source": "Despite what some pilots claim, moving slightly to the left is not a good evasive manoeuvre.",
      "target_zh_TW": "不管某些飛行員怎麼說，稍微往左移並不是好的閃避動作。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_moveLeft",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_stayFast::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_stayFast",
      "segment_index": 0,
      "source": "Staying fast is key to staying alive. Manage your power settings carefully to ensure you have enough engine power.",
      "target_zh_TW": "保持高速是活命的關鍵。謹慎管理能量設定，確保引擎有足夠的動力。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_stayFast",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_powerEngines::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_powerEngines",
      "segment_index": 0,
      "source": "At increased laser and shield power levels, less power is available for your engines.",
      "target_zh_TW": "雷射砲與護盾的能量越高，可分配給引擎的能量就越少。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_powerEngines",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_starDestroyers::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_starDestroyers",
      "segment_index": 0,
      "source": "Star Destroyers are formidable in battle, but have weak spots that can be exploited.",
      "target_zh_TW": "滅星者在戰鬥中十分難纏，但也有可供利用的弱點。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_starDestroyers",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_anticipateMovement::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_anticipateMovement",
      "segment_index": 0,
      "source": "Anticipate your enemies' movement and aim accordingly for maximum accuracy.",
      "target_zh_TW": "預判敵人的動向並據此瞄準，以獲得最高命中率。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_anticipateMovement",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_transferLaserToShields::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_transferLaserToShields",
      "segment_index": 0,
      "source": "Transfer laser energy to your shields for extra protection during a fight.",
      "target_zh_TW": "在戰鬥中將雷射能量轉移到護盾，以獲得額外防護。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_transferLaserToShields",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_transferShieldsToLaser::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_transferShieldsToLaser",
      "segment_index": 0,
      "source": "Shield energy can be used to recharge your lasers during a battle.",
      "target_zh_TW": "戰鬥中可以用護盾能量為雷射砲充能。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_transferShieldsToLaser",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_orderCoverMe::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_orderCoverMe",
      "segment_index": 0,
      "source": "If you get into trouble, order your wingmen to help you out.",
      "target_zh_TW": "如果陷入困境，命令你的僚機前來支援。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_orderCoverMe",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_damageControl::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_damageControl",
      "segment_index": 0,
      "source": "Check the repair order of your systems in the damage control screen.",
      "target_zh_TW": "在損害控制畫面中查看各系統的修復順序。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_damageControl",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_orderIgnore::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_orderIgnore",
      "segment_index": 0,
      "source": "You can order your wingmen to ignore a target if needed.",
      "target_zh_TW": "必要時，你可以命令僚機忽略某個目標。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_orderIgnore",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_timeMultiplier::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_timeMultiplier",
      "segment_index": 0,
      "source": "Mission taking too long? You can accelerate time, but use it wisely.",
      "target_zh_TW": "任務拖太久了？你可以加速時間，但請明智使用。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_timeMultiplier",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    },
    {
      "id": "XWVM.xwing.Tips.xliff::XWVM.xwing.Tips::tip_reinforcements::segment-1",
      "file_index": 0,
      "file_id": "XWVM.xwing.Tips",
      "unit_id": "tip_reinforcements",
      "segment_index": 0,
      "source": "If a mission is too difficult, call for reinforcements if available.",
      "target_zh_TW": "如果任務太困難，可在有增援時呼叫增援。",
      "source_format": "text",
      "context": "XWVM.xwing.Tips / tip_reinforcements",
      "notes": [],
      "requires_translation": true,
      "translator_note": ""
    }
  ]
}
