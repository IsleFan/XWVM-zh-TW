		<!-- ==================== TRIGGER FORMAT STRINGS ==================== -->
		<unit id="Trigger_FgCondition_Format">
			<notes>
				<note>{amount} = amount text, {condition} = condition text. Don't alter the \{0\} placeholder.</note>
			</notes>
			<segment state="translated">
				<source>{amount} of \{0\}: {condition}</source>
				<target>\{0\} {amount}：{condition}</target></segment>
		</unit>
		<unit id="Trigger_OrWentHome">
			<segment state="translated">
				<source> or Went Home</source>
				<target> 或已返航</target></segment>
		</unit>
		<unit id="Trigger_Or">
			<segment state="translated">
				<source> or </source>
				<target> 或 </target></segment>
		</unit>
		<unit id="Trigger_And">
			<segment state="translated">
				<source> and </source>
				<target> 且 </target></segment>
		</unit>

		<!-- ==================== GOAL FORMAT STRINGS ==================== -->
		<!-- For single ship: just condition. For multiple: amount + condition -->
		<unit id="Goal_SingleShip_Format">
